disp(Input_Torque);

%Angular Velocity Calculations
%Loop ABCDA

syms wBC wDCE
omega_AB = [0 0 2.63];
omega_BC = [0 0 wBC];
omega_DCE = [0 0 wDCE];

eqn11 = cross(omega_AB,B-A) + cross(omega_BC,B-A) + cross(omega_DCE,C-D);

loop1Solution = solve(eqn11,[wBC wDCE]);

%Extract angular velocities from loop solution
angularVelocity_DCE = double(loop1Solution.wDCE);
angularVelocity_BC = double(loop1Solution.wBC);

%loop DEFGD
syms wEF wFG;
omega_EF = [0 0 wEF];
omega_FG = [0 0 wFG];

omegaBC = [0 0 angularVelocity_BC];
omegaDCE = [0 0 angularVelocity_DCE];

eqn12 = cross(omegaDCE,E-D) + cross(omegaBC,C-B) + cross(omega_EF,F-E) + cross(omega_FG,G-F) == 0;

loop2Solution = solve(eqn12,[wEF wFG]);

angularVelocity_EF = double(loop2Solution.wEF)
angularVelocity_FG = double(loop2Solution.wFG)

omegaEF = [0 0 angularVelocity_EF];
omegaFG = [0 0 angularVelocity_FG];


%Angular Acceleration Calculations

syms aDCE aBC
alpha_AB = [0 0 0];
alpha_DCE = [0 0 aDCE];
alpha_BC = [0 0 aBC];

a_B_A = cross(alpha_AB, B-A) + cross(omega_AB,cross(omega_AB,B-A));
a_C_D =  cross(alpha_DCE, C-D) + cross(omegaDCE,cross(omegaDCE,C-D));
a_B_C = cross(alpha_BC, B-C) + cross(omegaBC,cross(omegaBC,B-C));

eqn13 = a_B_A + a_C_D + a_B_C ==0;

loop1AccSolution = solve(eqn13,[aDCE aBC]);

alphaDCE = double(loop1AccSolution.aDCE)
alphaBC = double(loop1AccSolution.aBC)

alphaBC_Vector = [0 0 alphaBC];
alphaDCE_Vector = [0 0 alphaDCE];

%loop DEFGD

syms aEF aFG;
alpha_EF = [0 0 aEF];
alpha_FG = [0 0 aFG];

a_D_E = cross(alphaDCE_Vector,E-D) + cross(omegaDCE,cross(omegaDCE,E-D));

angVel_EF = [0 0 angularVelocity_EF];
angVel_FG = [0 0 angularVelocity_FG];

a_F_E = cross(alpha_EF,F-E) + cross(angVel_EF,cross(angVel_EF,F-E));

a_G_F = cross(alpha_FG,G-F) + cross(angVel_FG,cross(angVel_FG,G-F));

eqn14 =  a_D_E + a_F_E + a_G_F == 0;

loop2AccSolution = solve(eqn14, [aEF aFG]);

alphaEF = double(loop2AccSolution.aEF);
alphaFG = double(loop2AccSolution.aFG);

%velocity at Joints

v_B_A = cross(omega_AB,B-A);

v_C_B = cross(omegaBC,C-B);

Ve_B = v_B_A + v_C_B

%Ve_C = v_B_C + v_E_C;

v_B_C = cross(omegaBC,C-B);

v_E_C = cross(omegaDCE,E-C);

Ve_C = v_B_C + v_E_C

%Ve_E = v_C_E + v_F_E;

v_C_E = cross(omegaDCE,C-E);

v_F_E = cross(omegaEF,F-E);

Ve_E = v_C_E + v_F_E

%Ve_F = v_E_F + v_G_F;

v_E_F = cross(omegaEF,E-F);

v_G_F = cross(omegaFG,F-G);

Ve_F = v_E_F + v_G_F

%v_s1_A = v_s1_B + v_A_B

v_s1_A = cross(omega_AB,s1-A);

v_B_A = cross(omega_AB,B-A);

vs1_A = v_s1_A + v_B_A;

%v_s2_B = v_s2_C + V_B_C

v_s2_B = cross(omegaBC,s2-B);

v_B_A = cross(omegaBC,C-B);

vs2_B = v_s2_B + v_B_A

%v_s3_C = v_s3_E + V_D_E

v_s3_E = cross(omegaDCE,s3-E);

v_D_E = cross(omegaDCE,E-D);

v_s3_C = v_s3_E + v_D_E

%V_s4_E = V_s4_F + V_E_F

v_s4_F = cross(omegaEF,s4-F);

v_E_F = cross(omegaEF,F-E);

v_s4_E = v_s4_F + v_E_F

%v_s5_F = v_s5_G + v_F_G

v_s5_G = cross(omegaFG,s5-G);

v_F_G = cross(omegaFG,G-F);

v_s5_F = v_s5_G + v_F_G

%Accelerations at com of every link

as1_A = cross(alpha_AB,s1-A) + cross(omega_AB,cross(omega_AB,s1-A));

as2_B = cross(alphaBC_Vector,s2-C) + cross(omegaBC,cross(omegaBC,s2-C));

as3_D = cross(alphaDCE_Vector,s3-D) + cross(omegaDCE,cross(omegaDCE,s3-D));

as4_G = cross([0 0 alphaEF],s4-F) + cross(angVel_EF,cross(angVel_EF, s4-F));

as5_G = cross([0 0  alphaFG], s5-G) + cross(omegaFG, cross(omegaFG, s5-G));

%Newtons Second Law Implementation

MassAB = 1;
MassBC = 1;
MassDCE = 1;
MassEF = 1;
MassFG = 1;

%Mass Moment of Inertia
J_AB = 1;
J_BC = 1;
J_DCE= 1;
J_EF = 1;
J_FG = 1;

