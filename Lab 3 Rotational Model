clc
clear

%Values of different Parameters

Jeq=0.497;%kg
Keq=2531;%N/m
B=0;%N.s/m
F=912.04;%N

syms x(t) %x(t) is the x in Mx''+bx'+Kx = F

eqn1=Jeq*diff(x,t,2)+B*diff(x,t)+Keq*x==F;
%Note: in the above equation, x'' is written as diff(x,t,2)
%x' is diff(x,t)

Dx=diff(x,t)

%specifying initial conditions
initialCon=[x(0)==0, Dx(0)==0];

%solving for X(t)
solutionX=dsolve(eqn1,initialCon);

%Solving for V(t) - Velocity as function of time
solutionV=diff(solutionX);

%solving for A(t) - acceleration as function of time
solutionA=diff(solutionV);

%Plotting X(t) between times 0 and 10s
fplot(solutionX,[0 1])
title('Displacement Over Time');
xlabel('Time(s)');
ylabel('Displacement (cm)');

fplot(solutionV,[0 1])
title('Velocity Over Time');
xlabel('Time(s)');
ylabel('Velocity (cm/s)');

fplot(solutionA,[0 1])
title('Acceleration Over Time');
xlabel('Time(s)');
ylabel('Acceleration (cm/s^2)');
